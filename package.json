{
  "name": "@outfitter/forge",
  "version": "0.0.0",
  "private": true,
  "description": "Shared engineering automation for Outfitter and personal repositories.",
  "type": "module",
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "evaluate": "bun src/cli.ts",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "typescript": "7.0.2",
    "ultracite": "7.8.3"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
