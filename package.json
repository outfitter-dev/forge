{
  "name": "@outfitter/forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared engineering automation for Outfitter and personal repositories.",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
