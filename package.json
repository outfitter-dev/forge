{
  "name": "@outfitter/forge",
  "version": "0.0.0",
  "private": true,
  "description": "Shared engineering automation for Outfitter and personal repositories.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "evaluate": "bun src/cli.ts",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "typecheck": "bun check --no-script",
    "test": "bun test",
    "format:check": "oxfmt --check .",
    "forge": "bun src/forge-cli.ts",
    "check:hook": "lefthook run pre-push --no-auto-install --force"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "ultracite": "8.1.1"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": []
}
